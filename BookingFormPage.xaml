<Page x:Class="pr5.BookingFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookingFormPage" Background="White">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <Label Content="ID"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Id}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <Label Content="Клиент"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Client}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0">
            <Label Content="Дата"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <DatePicker Margin="5" SelectedDate="{Binding Date}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0">
            <Label Content="Номер комнаты"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1">
            <TextBox Margin="5" Text="{Binding RoomNumber}"/>
        </StackPanel>

        <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Header="Услуги" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                    <Button Content="Добавить услугу" Width="140" Height="25" Click="AddService_Click"/>
                    <Button Content="Удалить услугу" Width="140" Height="25" Click="DeleteService_Click" Margin="10,0,0,0"/>
                </StackPanel>

                <ListView Grid.Row="1" Margin="5" 
                      ItemsSource="{Binding Services}"
                      SelectedItem="{Binding SelectedService, RelativeSource={RelativeSource AncestorType=Page}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Наименование: "/>
                                <TextBlock Text="{Binding Name}" Width="150"/>
                                <TextBlock Text="Цена: "/>
                                <TextBlock Text="{Binding Price}" Width="80"/>
                                <TextBlock Text="Кол-во: "/>
                                <TextBlock Text="{Binding Count}" Width="50"/>
                                <TextBlock Text="Стоимость: "/>
                                <TextBlock Text="{Binding ServiceTotal}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="5">
                    <TextBlock Text="Наименование:" VerticalAlignment="Center"/>
                    <TextBox x:Name="NewServiceName" Width="150" Margin="5"/>

                    <TextBlock Text="Цена:" VerticalAlignment="Center"/>
                    <TextBox x:Name="NewServicePrice" Width="80" Margin="5"/>

                    <TextBlock Text="Количество:" VerticalAlignment="Center"/>
                    <TextBox x:Name="NewServiceCount" Width="60" Margin="5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5">
            <Button Content="Сохранить" Width="100" Height="25" Click="SaveButton_Click"/>
            <Button Content="Назад" Width="100" Height="25" Click="BackButton_Click" Margin="10,0,0,0"/>
            <Label Content="Итого: " FontWeight="Bold"/>
            <Label Content="{Binding BookingTotal}" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>
